def warn(msg):
    print(f"  ! {msg}", file=sys.stderr)


def note(msg):
    print(f"Note: {msg}", file=sys.stderr)


def warn_missing_file(path):
    warn(f"File not found, skipping: {path}")


def missing_package(display_name, pip_name, reason):
    """Print a standard "not installed" note for an optional dependency."""
    note(f"{display_name} not installed (pip install {pip_name}) -- {reason}")


def prompt_action(message):
    """Print `message` and a CHECK_OPTIONS menu, return the chosen
    key ("skip" if stdin is exhausted)."""
    print(f"  ! {message}")
    keys = list(CHECK_OPTIONS)
    for i, key in enumerate(keys, 1):
        print(f"      {i}) {CHECK_OPTIONS[key]}")
    while True:
        try:
            choice = input(f"    Choice [1-{len(keys)}]: ").strip()
        except EOFError:
            print("    (no input available, leaving as-is)")
            return "skip"
        if choice.isdigit() and 1 <= int(choice) <= len(keys):
            return keys[int(choice) - 1]
        print("    Invalid choice.")


def build_editor_command(editor, path, line):
    """Build argv to open `path` in `editor`, jumping to `line`
    (1-indexed) if `editor` supports "+N"."""
    command = shlex.split(editor) or ["vi"]
    if line is not None and Path(command[0]).name in LINE_JUMP_EDITORS:
        command.append(f"+{line}")
    command.append(str(path))
    return command


# ---------------------------------------------------------------------------
# Tag I/O. mutagen's "easy" interface covers mp3/flac/ogg/opus/m4a/wma;
# WAV needs raw ID3 frames instead (TIT2/TPE1/TALB/TRCK).
# ---------------------------------------------------------------------------

def load_track(path):
    """Return an opaque tag handle for `path`, or None if unreadable."""
    if path.suffix.lower() == ".wav":
        audio = mutagen.File(str(path))
        return ("wav", audio)
    audio = mutagen.File(str(path), easy=True)
    if audio is None:
        return None
    return ("easy", audio)


def get_tags_wav(audio):
    tags = audio.tags
    if tags is None:
        return {
            "album": None,
            "artist": None,
            "artists": [],
            "title": None,
            "tracknumber": None,
        }
    txxx_artists = tags.getall("TXXX:ARTISTS")
    return {
        "album": tags["TALB"].text[0] if "TALB" in tags else None,
        "artist": tags["TPE1"].text[0] if "TPE1" in tags else None,
        "artists": (
            [str(v) for v in txxx_artists[0].text] if txxx_artists else []
        ),
        "title": tags["TIT2"].text[0] if "TIT2" in tags else None,
        "tracknumber": tags["TRCK"].text[0] if "TRCK" in tags else None,
    }


def get_tags_easy(audio):
    def _str(values):
        # ASF (wma) returns ASFUnicodeAttribute objects, not str.
        return str(values[0]) if values else None

    def _str_list(values):
        return [str(v) for v in values] if values else []

    return {
        "album": _str(audio.get("album")),
        "artist": _str(audio.get("artist")),
        "artists": _str_list(audio.get("artists")),
        "title": _str(audio.get("title")),
        "tracknumber": _str(audio.get("tracknumber")),
    }


def get_tags(handle):
    kind, audio = handle
    return get_tags_wav(audio) if kind == "wav" else get_tags_easy(audio)


def set_tags_wav(audio, updates):
    if audio.tags is None:
        audio.add_tags()
    frame_map = {
        "album": TALB,
        "artist": TPE1,
        "title": TIT2,
        "tracknumber": TRCK,
    }
    for key, value in updates.items():
        if key == "artists":
            audio.tags.delall("TXXX:ARTISTS")
            audio.tags.add(
                TXXX(encoding=3, desc="ARTISTS", text=list(value)),
            )
        else:
            audio.tags.add(frame_map[key](encoding=3, text=str(value)))


def set_tags_easy(audio, updates):
    for key, value in updates.items():
        audio[key] = list(value) if key == "artists" else str(value)


def set_tags(handle, updates):
    kind, audio = handle
    if kind == "wav":
        set_tags_wav(audio, updates)
    else:
        set_tags_easy(audio, updates)
    audio.save()


# ---------------------------------------------------------------------------
# Track-number / filename parsing
# ---------------------------------------------------------------------------

# Matches filenames like "Track 3", "track03", "01 - Song Title", "3 Song",
# but not a 3+ digit run (e.g. a title like "400 Lux" or "1999") --
# albums essentially never have >99 tracks.
FILENAME_TRACK_RE = re.compile(
    r"^\s*(?:track[\s_.-]*)?0*(\d{1,2})\b", re.IGNORECASE,
)

# Like FILENAME_TRACK_RE but also consumes the trailing separator,
# e.g. "01 - Song Title" -> "Song Title".
FILENAME_TRACK_PREFIX_RE = re.compile(
    r"^\s*(?:track[\s_.-]*)?0*\d{1,2}\b[\s_.-]*", re.IGNORECASE,
)


def normalize_track(value):
    """Extract the leading integer from a tracknumber field like '3/12'."""
    if value is None:
        return None
    match = re.match(r"\s*(\d+)", str(value))
    return int(match.group(1)) if match else None


def track_number_from_filename(stem):
    match = FILENAME_TRACK_RE.match(stem)
    return int(match.group(1)) if match else None


def strip_filename_track_prefix(stem):
    return FILENAME_TRACK_PREFIX_RE.sub("", stem)


def fuzzy_ratio(a, b):
    if not a or not b:
        return 0.0
    a, b = a.lower().strip(), b.lower().strip()
    return difflib.SequenceMatcher(None, a, b).ratio()


def char_diff_count(a, b):
    """Rough count of differing characters between two strings."""
    matcher = difflib.SequenceMatcher(None, a, b)
    return sum(
        max(i2 - i1, j2 - j1)
        for tag, i1, i2, j1, j2 in matcher.get_opcodes()
        if tag != "equal"
    )


# ---------------------------------------------------------------------------
# Filename rendering, e.g. "%num - %title" -> "01 - Song Title.mp3"
# ---------------------------------------------------------------------------

ILLEGAL_FILENAME_CHARS_RE = re.compile(r'[\\/:*?"<>|\x00-\x1f]')


def sanitize_filename_part(text):
    return ILLEGAL_FILENAME_CHARS_RE.sub("", text).strip()


def render_filename(template, path, final_tags):
    track_no = normalize_track(final_tags.get("tracknumber"))
    values = {
        "%num": f"{track_no:02d}" if track_no is not None else "00",
        "%title": (final_tags.get("title") or "").strip() or path.stem,
        "%artist": final_tags.get("artist") or "",
        "%album": final_tags.get("album") or "",
        "%ext": path.suffix.lstrip("."),
    }
    name = template
    for placeholder, value in values.items():
        name = name.replace(placeholder, sanitize_filename_part(str(value)))
    if "%ext" not in template:
        name += path.suffix
    # The template itself may contain invalid filename characters too.
    name = sanitize_filename_part(name)
    if name in ("", ".", ".."):
        name = "_" + name
    return name


# ---------------------------------------------------------------------------
# Recognition: MusicBrainz text search.
# ---------------------------------------------------------------------------

MIN_ACOUSTID_SCORE = 0.6       # AcoustID's own match score (0-1)


def recognize_via_musicbrainz_text(folder_artist, folder_album):
    """Search MusicBrainz by artist+album name and return
    {position: {"title": ..., "artists": [...]}}."""
    results = musicbrainzngs.search_releases(
        artist=folder_artist, release=folder_album, limit=1,
    )
    releases = results.get("release-list") or []
    if not releases:
        return None
    full = musicbrainzngs.get_release_by_id(
        releases[0]["id"], includes=["recordings", "artist-credits"],
    )
    track_map = {}
    for medium in full["release"].get("medium-list", []):
        for track in medium.get("track-list", []):
            recording = track["recording"]
            credit = recording.get("artist-credit") or []
            artist_names = [
                c["artist"]["name"] for c in credit
                if isinstance(c, dict) and "artist" in c
            ]
            track_map[int(track["position"])] = {
                "title": recording["title"], "artists": artist_names,
            }
    return track_map or None


# ---------------------------------------------------------------------------
# Album art: MusicBrainz + Cover Art Archive. `scan` downloads it into a
# tmp/art queue for review; `apply` copies it onto the real album dirs.
# ---------------------------------------------------------------------------

ALBUM_ART_FILENAME = "art.jpg"
ALBUM_ART_SIZE = (300, 300)
COVER_ART_ARCHIVE_FRONT_URL = (
    "https://coverartarchive.org/release/{mbid}/front"
)


def find_release_id(artist_name, album_name):
    results = musicbrainzngs.search_releases(
        artist=artist_name, release=album_name, limit=1,
    )
    releases = results.get("release-list") or []
    return releases[0]["id"] if releases else None


def fetch_cover_art(release_id):
    request = Request(
        COVER_ART_ARCHIVE_FRONT_URL.format(mbid=release_id),
        headers={"User-Agent": "music-metafix/0.0"},
    )
    with urlopen(request, timeout=20) as response:
        return response.read()


def save_album_art(image_bytes, dest_path):
    image = Image.open(io.BytesIO(image_bytes)).convert("RGB")
    image = image.resize(ALBUM_ART_SIZE, Image.LANCZOS)
    image.save(dest_path, "JPEG")


def download_album_art(artist_name, album_name, dest_dir, filename):
    """Fetch cover art into <dest_dir>/<filename>. Errors are logged
    and skipped, never raised."""
    dest_dir.mkdir(parents=True, exist_ok=True)
    art_path = dest_dir / filename
    album_key = f"{artist_name}/{album_name}"

    try:
        release_id = find_release_id(artist_name, album_name)
    except Exception as exc:
        warn(f"MusicBrainz release search failed for {album_key}: {exc}")
        return
    if not release_id:
        warn(f"No MusicBrainz release found for album art: {album_key}")
        return

    try:
        save_album_art(fetch_cover_art(release_id), art_path)
        print(f"Album art: {art_path}")
    except HTTPError as exc:
        if exc.code == 404:
            warn(f"No cover art available for {album_key}")
        else:
            warn(f"Cover art download failed for {album_key}: {exc}")
    except (URLError, OSError) as exc:
        warn(f"Cover art download failed for {album_key}: {exc}")


# ---------------------------------------------------------------------------
# Shared root-walking / ignore-file plumbing
# ---------------------------------------------------------------------------

AUDIO_EXTENSIONS = {
    ".mp3", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".wma", ".wav",
}

MMFIGNORE_FILENAME = ".mmfignore"


def load_mmfignore(root):
    """Load ".mmfignore" from `root` as a pathspec, or None if there
    isn't one (or pathspec isn't installed)."""
    ignore_path = Path(root) / MMFIGNORE_FILENAME
    if not ignore_path.exists():
        return None
    if pathspec is None:
        missing_package(
            "pathspec", "pathspec",
            f"{ignore_path} is present but its rules can't be applied.",
        )
        return None
    with open(ignore_path, encoding="utf-8") as f:
        return pathspec.PathSpec.from_lines("gitwildmatch", f)


def is_ignored(spec, root, path):
    """True if `path` under `root` matches `spec` (None matches
    nothing)."""
    if spec is None:
        return False
    rel = path.relative_to(root).as_posix()
    if path.is_dir():
        rel += "/"
    return spec.match_file(rel)


def iter_dirs(path):
    """Subdirectories of `path`, sorted by name."""
    return sorted(p for p in path.iterdir() if p.is_dir())


def iter_files(path):
    """Files directly in `path`, sorted by name."""
    return sorted(p for p in path.iterdir() if p.is_file())


def iter_albums(root, spec=None):
    root = Path(root)
    if spec is None:
        spec = load_mmfignore(root)
    for artist_dir in iter_dirs(root):
        if is_ignored(spec, root, artist_dir):
            continue
        for album_dir in iter_dirs(artist_dir):
            if is_ignored(spec, root, album_dir):
                continue
            yield artist_dir.name, album_dir.name, album_dir


def iter_music_files(root):
    root = Path(root)
    spec = load_mmfignore(root)
    for artist_name, album_name, album_dir in iter_albums(root, spec):
        for song_path in iter_files(album_dir):
            if song_path.suffix.lower() in AUDIO_EXTENSIONS \
                    and not is_ignored(spec, root, song_path):
                yield artist_name, album_name, song_path


def iter_music_files_of_ext(root, ext):
    for artist_name, album_name, path in iter_music_files(root):
        if path.suffix.lower() == ext:
            yield artist_name, album_name, path


def iter_non_ignored_files(root, spec):
    """Depth-first walk of every non-ignored file under root, skipping
    whole ignored directories rather than just filtering their files."""
    root = Path(root)
    stack = [root]
    while stack:
        current = stack.pop()
        for entry in sorted(current.iterdir()):
            if is_ignored(spec, root, entry):
                continue
            if entry.is_dir():
                stack.append(entry)
            else:
                yield entry


# ---------------------------------------------------------------------------
# Backups: taken before any step that modifies root, unless --no-backup.
# ---------------------------------------------------------------------------

def create_backup(root, tmp_dir):
    root = Path(root)
    spec = load_mmfignore(root)
    backups_dir = Path(tmp_dir) / "backups"
    backups_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_path = backups_dir / f"{root.name}-{timestamp}.tar.gz"
    with tarfile.open(backup_path, "w:gz") as tar:
        for path in iter_non_ignored_files(root, spec):
            tar.add(path, arcname=str(path.relative_to(root)))
    print(f"Backup created: {backup_path}")
    return backup_path


def maybe_backup(args, root):
    if not args.no_backup:
        create_backup(root, args.tmp_dir)


# ---------------------------------------------------------------------------
# rename
# ---------------------------------------------------------------------------

def run_rename(root, template):
    """Rename every music file under root to `template`, rendered
    from its current on-disk tags."""
    for _artist_name, _album_name, path in iter_music_files(root):
        handle = load_track(path)
        if handle is None:
            warn(f"Could not read tags, skipping: {path}")
            continue

        new_name = render_filename(template, path, get_tags(handle))
        if new_name == path.name:
            continue

        try:
            new_path = path.with_name(new_name)
            if new_path.exists():
                warn(f"Rename target already exists, skipping: {new_path}")
                continue
            path.rename(new_path)
        except ValueError as exc:
            warn(
                f"Invalid rename target, skipping: "
                f"{path} -> {new_name!r} ({exc})"
            )
            continue

        print(f"Renamed: {path.name} -> {new_name}")


def run_rename_step(args):
    maybe_backup(args, Path(args.root))
    run_rename(args.root, args.template)


def configure_musicbrainz(contact):
    """Set musicbrainzngs's user-agent. Returns False if the package
    isn't installed (caller prints its own "not installed" note)."""
    if not musicbrainzngs:
        return False
    musicbrainzngs.set_useragent("music-metafix", "0.0", contact)
    return True


# ---------------------------------------------------------------------------
# scan: MusicBrainz text search + queued album art
# ---------------------------------------------------------------------------

def render_yaml_scalar(value):
    """Render `value` as a single-line flow-style YAML scalar."""
    dumped = yaml.safe_dump(
        value, default_flow_style=True, allow_unicode=True, width=float("inf"),
    )
    return dumped.split("\n", 1)[0]


def should_replace_title(new_title, current_title):
    """True if `new_title` differs enough from `current_title` to be
    worth queuing."""
    return fuzzy_ratio(new_title, current_title) < FUZZY_SAME_ENOUGH


def should_replace_artists(new_artists, current_artists):
    """True if `new_artists` is non-empty and differs from
    `current_artists`."""
    return bool(new_artists) and new_artists != current_artists


def apply_track_match(updates, current, pos, match):
    """Queue title/tracknumber/artists updates for MusicBrainz track
    `match` at position `pos`, wherever it differs from `current`."""
    if should_replace_title(match["title"], current.get("title")):
        updates["title"] = match["title"]
    if normalize_track(current.get("tracknumber")) != pos:
        updates["tracknumber"] = str(pos)
    if should_replace_artists(match["artists"], current.get("artists")):
        updates["artists"] = match["artists"]


def queue_folder_trusted_fields(updates, current, artist_name, album_name):
    """Queue artist/album updates wherever the current tag doesn't
    match the folder-trusted name."""
    if (current.get("artist") or "").strip() != artist_name:
        updates["artist"] = artist_name
    if (current.get("album") or "").strip() != album_name:
        updates["album"] = album_name


def match_via_musicbrainz(
    updates, current, artist_name, album_name,
    filename_track, filename_title, args, mb_cache,
):
    """Place this file in `artist_name`/`album_name`'s MusicBrainz
    tracklist (cached in `mb_cache`), by `filename_track`'s position
    or else by fuzzy-matching `filename_title`. Queues title/
    tracknumber/artists updates on a match. Returns True if matched."""
    if not musicbrainzngs or args.no_musicbrainz:
        return False

    cache_key = (artist_name, album_name)
    if cache_key not in mb_cache:
        try:
            mb_cache[cache_key] = recognize_via_musicbrainz_text(
                artist_name, album_name,
            )
        except Exception as exc:
            warn(
                f"MusicBrainz search failed for "
                f"{artist_name}/{album_name}: {exc}"
            )
            mb_cache[cache_key] = None
    track_map = mb_cache[cache_key]
    if not track_map:
        return False

    if filename_track is not None and filename_track in track_map:
        # A filename-given position (e.g. "Track 03") beats fuzzy title
        # matching.
        apply_track_match(
            updates, current, filename_track, track_map[filename_track],
        )
        return True

    if not filename_title:
        return False
    best_pos, best_score = None, 0.0
    for pos, data in track_map.items():
        score = fuzzy_ratio(data["title"], filename_title)
        if score > best_score:
            best_score, best_pos = score, pos
    if best_pos is None or best_score < FUZZY_MATCH_THRESHOLD:
        return False
    apply_track_match(updates, current, best_pos, track_map[best_pos])
    return True


def build_queue_fields(current, updates):
    """Build the (fields, previous) pair compute_scan_change returns:
    `fields` has every QUEUE_FIELDS key, falling back to the current
    tag value where `updates` has none; `previous` holds the prior
    value for keys that are actually changing."""
    fields = {}
    previous = {}
    for key in QUEUE_FIELDS:
        if key in updates:
            value = updates[key]
            previous[key] = current.get(key)
        else:
            value = current.get(key) or None
        if key == "tracknumber" and value is not None and "/" not in value:
            value = int(value)
        fields[key] = value
    return fields, previous


def compute_scan_change(root, artist_name, album_name, path, args, mb_cache):
    """Work out what (if anything) should change for `path`. Read-only.
    Returns None, or (file, fields, previous) -- see build_queue_fields.
    No AcoustID fallback: if MusicBrainz can't place the file, a
    warning is printed and the scan moves on."""
    handle = load_track(path)
    if handle is None:
        raise RuntimeError("could not read tags")

    current = get_tags(handle)
    filename_track = track_number_from_filename(path.stem)
    filename_title = strip_filename_track_prefix(path.stem).strip()
    updates = {}

    queue_folder_trusted_fields(updates, current, artist_name, album_name)

    matched = match_via_musicbrainz(
        updates, current, artist_name, album_name,
        filename_track, filename_title, args, mb_cache,
    )
    if not matched:
        warn(f"No MusicBrainz match found for {path}")

    # Last resort: the filename alone gives a track number.
    if "tracknumber" not in updates and filename_track is not None \
            and normalize_track(current.get("tracknumber")) != filename_track:
        updates["tracknumber"] = str(filename_track)

    if not updates:
        return None

    fields, previous = build_queue_fields(current, updates)
    return str(path.relative_to(root)), fields, previous


def print_change(file, fields):
    """Print one file's pending changes to stdout."""
    print(file)
    for key in QUEUE_FIELDS:
        print(f"    {key}: {fields[key]!r}")


def write_queue_entry(queue_f, file, fields, previous):
    """Append one file's changes to the queue file, flushed +
    fsynced so a crash mid-run doesn't lose prior results."""
    queue_f.write(f"{render_yaml_scalar(file)}:\n")
    for key, value in fields.items():
        line = f"  {key}: {render_yaml_scalar(value)}"
        if previous.get(key):
            line += f"  # was: {render_yaml_scalar(previous[key])}"
        queue_f.write(line + "\n")
    queue_f.flush()
    os.fsync(queue_f.fileno())


def run_album_art_queue(root, art_dir, filename, contact):
    """Download fresh cover art for every album under root into
    art_dir/<artist>/<album>/<filename>, for later review and
    application via `apply`."""
    if not configure_musicbrainz(contact):
        missing_package(
            "musicbrainzngs", "musicbrainzngs", "can't download album art.",
        )
        return
    if Image is None:
        missing_package("Pillow", "pillow", "can't download album art.")
        return

    root = Path(root)
    art_dir = Path(art_dir)
    spec = load_mmfignore(root)
    for artist_name, album_name, album_dir in iter_albums(root, spec):
        if is_ignored(spec, root, album_dir):
            continue
        dest_dir = art_dir / artist_name / album_name
        download_album_art(artist_name, album_name, dest_dir, filename)


def warn_missing_scan_deps(args):
    """Note any missing/unconfigured MusicBrainz dependency."""
    if not configure_musicbrainz(args.musicbrainz_contact):
        missing_package(
            "musicbrainzngs", "musicbrainzngs",
            "text-search recognition disabled.",
        )


def write_queue_header(queue_f, root, args):
    queue_f.write(f"# root: {root.resolve()}\n")
    queue_f.write(QUEUE_HEADER.format(
        script=sys.argv[0], root=args.root, queue=args.queue,
    ))
    queue_f.flush()


def scan_one_file(queue_f, args, mb_cache, artist_name, album_name, path):
    """Compute and queue one file's change, if any. Returns the
    Counter key to tally: "queued", "ok", or "error"."""
    try:
        entry = compute_scan_change(
            args.root, artist_name, album_name, path, args, mb_cache,
        )
    except Exception as exc:
        warn(f"Unexpected error on {path}: {exc}")
        return "error"

    if entry is None:
        print(f"{path}: OK")
        return "ok"

    file, fields, previous = entry
    print_change(file, fields)
    write_queue_entry(queue_f, file, fields, previous)
    return "queued"


def print_scan_summary(counts, args):
    if counts["queued"]:
        print(f"\n{counts['queued']} pending change(s) written to {args.queue}")
        print(
            "Review it, then optionally:\n"
            f"  {sys.argv[0]} check {args.queue}\n"
            f"  {sys.argv[0]} fingerprint {args.root} {args.queue}\n"
            "then apply with:\n"
            f"  {sys.argv[0]} apply {args.root} {args.queue}"
        )
    else:
        print("\nNo changes needed.")
    print(f"({counts['ok']} already correct, {counts['error']} errors)")


def run_scan(args):
    """Scan every music file under root and queue pending changes for
    review, plus fresh album art (unless --no-art)."""
    warn_missing_scan_deps(args)

    root = Path(args.root)
    mb_cache = {}
    counts = Counter()

    queue_path = Path(args.queue)
    queue_path.parent.mkdir(parents=True, exist_ok=True)
    with open(queue_path, "w", encoding="utf-8") as queue_f:
        write_queue_header(queue_f, root, args)
        for artist_name, album_name, path in iter_music_files(args.root):
            counts[scan_one_file(
                queue_f, args, mb_cache, artist_name, album_name, path,
            )] += 1

    if not args.no_art:
        run_album_art_queue(
            args.root, args.art_dir, args.art_filename,
            args.musicbrainz_contact,
        )

    print_scan_summary(counts, args)


# ---------------------------------------------------------------------------
# fingerprint: AcoustID sanity check on the title scan queued
# ---------------------------------------------------------------------------

FINGERPRINT_TITLE_THRESHOLD = 0.5   # deliberately low -- just a sanity check

# Title variations stripped before comparing, so e.g. "Reckoner (Live)"
# or "Umbrella feat. Jay-Z - Radio Edit" compare equal to "Reckoner"/
# "Umbrella". Each stripper is skipped if it would empty the title.
BRACKETED_ASIDE_RE = re.compile(r"\s*[\(\[][^)\]]*[\)\]]\s*$")
FEATURE_CREDIT_RE = re.compile(
    r"\s*[-–—]?\s*\b(?:feat\.?|ft\.?|featuring)\s+.+$",
    re.IGNORECASE,
)
# A trailing " - <words>" clause is a version tag if any of its words
# is one of these -- broader than an exact-phrase list, so it also
# catches "Remastered 2011", "Acoustic Version", "Mono Mix", etc.
VERSION_TAG_WORDS = {
    "live", "acoustic", "remaster", "remastered", "edit", "mix", "remix",
    "version", "mono", "stereo", "demo", "instrumental", "explicit",
    "clean", "deluxe", "bonus", "single", "album", "radio", "extended",
    "original", "session", "alternate", "reprise", "outtake", "take",
    "unplugged", "rehearsal",
}
VERSION_TAG_RE = re.compile(r"\s+[-–—]\s+([^-–—]+)$")


def strip_bracketed_aside(text):
    """'Song (Live)' -> 'Song': drop a trailing (...)/[...] group."""
    return BRACKETED_ASIDE_RE.sub("", text).strip()


def strip_feature_credit(text):
    """'Song feat. X' -> 'Song': drop a bare feat./ft./featuring
    credit (one already inside brackets is caught by the stripper
    above)."""
    return FEATURE_CREDIT_RE.sub("", text).strip()


def strip_version_tag(text):
    """'Song - Remastered 2011' -> 'Song': drop a trailing ' - ...'
    clause if it looks like a version/edit tag."""
    match = VERSION_TAG_RE.search(text)
    if not match:
        return text
    words = set(re.findall(r"[a-z]+", match.group(1).lower()))
    if not words & VERSION_TAG_WORDS:
        return text
    return text[:match.start()].strip()


# Bracket stripping goes first and, on any change, every stripper is
# retried from the top -- so a "feat." or version tag nested inside a
# not-yet-removed bracket (e.g. "Song (feat. X) (Live)") is never
# reached directly; the bracket around it is always drained first.
TITLE_STRIPPERS = (
    strip_bracketed_aside, strip_version_tag, strip_feature_credit,
)


def strip_title_variations(title):
    """Repeatedly apply TITLE_STRIPPERS, restarting from the top after
    every change, until none of them apply. Never strips a title down
    to nothing."""
    text = title.strip()
    changed = True
    while changed:
        changed = False
        for strip in TITLE_STRIPPERS:
            candidate = strip(text)
            if candidate and candidate != text:
                text, changed = candidate, True
                break
    return text


def acoustid_recording_titles(path, api_key):
    """Fingerprint `path` and return every recording title AcoustID
    offers with at least MIN_ACOUSTID_SCORE confidence."""
    duration, fp = acoustid.fingerprint_file(str(path))
    response = acoustid.lookup(api_key, fp, duration, meta=["recordings"])
    if response.get("status") != "ok":
        message = response.get("error", {}).get("message", "unknown error")
        raise acoustid.WebServiceError(message)

    titles = []
    for result in response.get("results", []):
        if result.get("score", 0) < MIN_ACOUSTID_SCORE:
            continue
        for recording in result.get("recordings", []):
            title = recording.get("title")
            if title:
                titles.append(title)
    return titles


def check_fingerprint_title(path, api_key, queued_title):
    """Return (ok, best_title, best_score): ok is None if AcoustID had
    nothing to compare against, else whether the best candidate title
    is a close enough (if rough) match for `queued_title`."""
    titles = acoustid_recording_titles(path, api_key)
    if not titles:
        return None, None, 0.0

    target = strip_title_variations(queued_title)
    best_title, best_score = None, 0.0
    for title in titles:
        score = fuzzy_ratio(strip_title_variations(title), target)
        if score > best_score:
            best_score, best_title = score, title
    return best_score >= FINGERPRINT_TITLE_THRESHOLD, best_title, best_score


class AbortFingerprinting(Exception):
    """Raised for an AcoustID failure that affects every remaining
    file, not just the one being checked."""


def fingerprint_one_file(root, api_key, file, fields):
    """Fingerprint-check one queue entry. Returns the counter keys to
    tally: ("skipped",), ("checked",), or ("checked", "mismatch")."""
    title = fields.get("title")
    if not title:
        return ("skipped",)

    path = root / file
    if not path.exists():
        warn_missing_file(path)
        return ("skipped",)

    try:
        ok, best_title, best_score = check_fingerprint_title(
            path, api_key, str(title),
        )
    except acoustid.NoBackendError:
        raise AbortFingerprinting(
            "fpcalc/chromaprint not found -- install libchromaprint-tools."
        )
    except acoustid.WebServiceError as exc:
        raise AbortFingerprinting(f"AcoustID web service error: {exc}")
    except acoustid.AcoustidError as exc:
        warn(f"AcoustID lookup failed for {path.name}: {exc}")
        return ("skipped",)

    if ok is None:
        warn(f"{file}: no AcoustID fingerprint match found for this file.")
        return ("checked",)
    if not ok:
        warn(
            f"{file}: queued title {title!r} doesn't match fingerprint "
            f"(closest: {best_title!r}, similarity {best_score:.2f})"
        )
        return ("checked", "mismatch")
    return ("checked",)


def run_fingerprint(args):
    """Fingerprint every file in the queue and warn (without
    prompting) about any whose queued title doesn't roughly match
    what AcoustID hears."""
    if not acoustid:
        missing_package("pyacoustid", "pyacoustid", "can't fingerprint.")
        return
    if not args.acoustid_api_key:
        note(
            "no AcoustID API key set (--acoustid-api-key or "
            "$MMF_ACOUSTID_API_KEY) -- can't fingerprint."
        )
        return

    root = Path(args.root)
    with open(args.queue, encoding="utf-8") as f:
        entries = yaml.safe_load(f) or {}

    counts = Counter()
    try:
        for file, fields in entries.items():
            counts.update(fingerprint_one_file(
                root, args.acoustid_api_key, file, fields,
            ))
    except AbortFingerprinting as exc:
        warn(f"{exc} Aborting fingerprint check.")
        return

    print(
        f"\n{counts['checked']} track(s) fingerprinted, "
        f"{counts['mismatch']} mismatch(es), {counts['skipped']} skipped."
    )


