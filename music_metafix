    rename_p = subparsers.add_parser(
        "rename", help="Rename files under root from a tag-rendered template.",
    )
    add_root_arg(rename_p)
    rename_p.add_argument(
        "template",
        help="Template rendered from current tags, e.g. '%%num - %%title' "
             "-> '01 - Song Title.mp3'. Placeholders: %%num, %%title, "
             "%%artist, %%album, %%ext.",
    )
    add_backup_args(rename_p)


def build_arg_parser():
    parser = argparse.ArgumentParser(
        prog="music_metafix",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="step", required=True)
    add_scan_args(subparsers)
    add_check_args(subparsers)
    add_fingerprint_args(subparsers)
    add_apply_args(subparsers)
    add_normalize_args(subparsers)
    add_convert_args(subparsers)
    add_rename_args(subparsers)
    return parser


STEP_HANDLERS = {
    "scan": run_scan,
    "check": lambda args: run_check(args.queue),
    "fingerprint": run_fingerprint,
    "apply": run_apply,
    "normalize": run_normalize,
    "convert": run_convert,
    "rename": run_rename_step,
}


def main():
    args = build_arg_parser().parse_args()
    STEP_HANDLERS[args.step](args)


if __name__ == "__main__":
    main()
