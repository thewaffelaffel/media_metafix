        "--no-musicbrainz", action="store_true",
        help="Disable MusicBrainz text search (folder-trusted "
             "artist/album and filename-derived track numbers still apply)",
    )


def add_check_args(subparsers):
    check_p = subparsers.add_parser(
        "check", help="Sanity-check a queued changes file.",
    )
    add_queue_arg(check_p, "Queue file to check")


def add_fingerprint_args(subparsers):
