# normalize / convert: ffmpeg re-encodes, mutagen re-applies tags
# ---------------------------------------------------------------------------

def ffmpeg_available():
    return shutil.which("ffmpeg") is not None


def build_ffmpeg_cmd(path, tmp_out, filter_arg):
    cmd = [
        "ffmpeg", "-y", "-loglevel", "error",
        "-i", str(path), "-map_metadata", "0",
    ]
    if filter_arg:
        cmd += ["-af", filter_arg]
    cmd.append(str(tmp_out))
    return cmd


def run_ffmpeg(cmd, tmp_out):
    """Run an ffmpeg command, raising RuntimeError (and cleaning up
    `tmp_out`) on failure."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode == 0:
        return
    tmp_out.unlink(missing_ok=True)
    stderr_lines = result.stderr.strip().splitlines() if result.stderr else []
    last_line = stderr_lines[-1] if stderr_lines else "unknown error"
    raise RuntimeError(f"ffmpeg failed: {last_line}")


def reencode_with_filter(path, filter_arg=None, new_suffix=None):
    """Re-encode `path` in place (or to `new_suffix` alongside it if
    given), preserving its tags. Returns the final path."""
    handle = load_track(path)
    if handle is None:
        raise RuntimeError("could not read tags")
    tags = get_tags(handle)

    tmp_out = path.with_name(f".{path.stem}.mmf-tmp{new_suffix or path.suffix}")
    run_ffmpeg(build_ffmpeg_cmd(path, tmp_out, filter_arg), tmp_out)

    final_path = path if new_suffix is None else path.with_suffix(new_suffix)
    if new_suffix is not None:
        path.unlink()
    tmp_out.replace(final_path)

    out_handle = load_track(final_path)
    if out_handle is not None:
        set_tags(out_handle, {k: v for k, v in tags.items() if v})
    return final_path


def run_normalize(args):
    """Loudness-normalize every track under root to a consistent
    volume via ffmpeg's single-pass loudnorm filter."""
    if not ffmpeg_available():
        note("ffmpeg not found -- can't normalize loudness.")
        return

    root = Path(args.root)
    maybe_backup(args, root)

    filter_arg = f"loudnorm=I={args.lufs}:TP=-1.5:LRA=11"
    counts = Counter()
    for _artist_name, _album_name, path in iter_music_files(root):
        try:
            reencode_with_filter(path, filter_arg=filter_arg)
            print(f"Normalized: {path}")
            counts["normalized"] += 1
        except Exception as exc:
            warn(f"Failed to normalize {path}: {exc}")
            counts["error"] += 1

    print(
        f"\n{counts['normalized']} track(s) normalized, "
        f"{counts['error']} error(s)."
    )


def run_convert(args):
    """Re-encode every file of extension `from` under root to `to`,
    preserving metadata."""
    if not ffmpeg_available():
        note("ffmpeg not found -- can't convert.")
        return

    from_ext = "." + args.from_ext.lower().lstrip(".")
    to_ext = "." + args.to_ext.lower().lstrip(".")
    if from_ext == to_ext:
        note("from and to formats are the same -- nothing to do.")
        return
    if from_ext not in AUDIO_EXTENSIONS:
        warn(f"{from_ext} isn't a recognized audio extension.")

    root = Path(args.root)
    maybe_backup(args, root)

    counts = Counter()
    for _artist_name, _album_name, path in iter_music_files_of_ext(
        root, from_ext,
    ):
        try:
            new_path = reencode_with_filter(path, new_suffix=to_ext)
            print(f"Converted: {path.name} -> {new_path.name}")
            counts["converted"] += 1
        except Exception as exc:
            warn(f"Failed to convert {path}: {exc}")
            counts["error"] += 1

    print(
        f"\n{counts['converted']} track(s) converted, "
        f"{counts['error']} error(s)."
    )


