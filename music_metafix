QUEUE_FIELDS = ("album", "artist", "artists", "title", "tracknumber")


def check_inconsistent_totals(lines, stats, album_dir, group):
    """Warn if tracks in an album disagree on the "/N" track total."""
    totals = chk.group_field_values(group, "tracknumber", parse_track_total)
    if len(totals) < 2:
        return

    parts = [
        f"{total} ({', '.join(f for f, _v in files)})"
        for total, files in totals.items()
    ]
    message = (
        f"{album_dir}: tracks disagree on the total track count: "
        f"{', '.join(parts)}."
    )
    chk.warn_fields(lines, stats, message, [
        (f, "tracknumber") for files in totals.values() for f, _v in files
    ])


def parse_track_total(raw):
    """The "/N" total from a tracknumber field like "3/12", or None."""
    if not isinstance(raw, str) or "/" not in raw:
        return None
    total_part = raw.split("/", 1)[1].strip()
    return int(total_part) if total_part.isdigit() else None


def check_album(lines, stats, album_dir, group):
    """Album-wide checks: track numbering, duplicates, and agreement
    on the folder-trusted artist/album."""
    track = ("tracknumber", "track number")
    chk.check_partial_numbers(lines, stats, album_dir, group, *track)
    chk.check_number_gaps(lines, stats, album_dir, group, *track)
    chk.check_duplicates(
        lines, stats, album_dir, group, "title", "title", chk.casefold_str,
    )
    chk.check_duplicates(
        lines, stats, album_dir, group, *track, normalize_track,
    )
    check_inconsistent_totals(lines, stats, album_dir, group)
    for key in ("artist", "album"):
        chk.check_inconsistent(lines, stats, album_dir, group, key)


def check_artist_matches_artists(lines, stats, file, fields):
    """Warn if the queued artist doesn't match artists[0] -- they
    should normally agree."""
    artist = fields.get("artist")
    artists = fields.get("artists")
    if not artist or not artists:
        return
    if str(artists[0]).strip() == str(artist).strip():
        return

    message = (
        f"{file}: artist {artist!r} doesn't match the first entry in "
        f"artists {artists!r}."
    )
    ok_lines = [
        chk.find_field_line(lines, file, "artist"),
        chk.find_field_line(lines, file, "artists"),
    ]
    restart_line = chk.find_entry_line(lines, file)
    chk.resolve_warning(lines, stats, message, ok_lines, restart_line)


def check_track(lines, stats, file, fields, group):
    """Per-track checks. The title isn't checked against the album --
    eponymous tracks are common."""
    track = ("tracknumber", "track number")
    chk.check_null_and_blank_fields(lines, stats, file, fields)
    chk.check_is_int(lines, stats, file, fields, *track)
    chk.check_in_range(lines, stats, file, fields, group, *track)
    chk.check_nonzero(lines, stats, file, fields, *track)
    chk.check_filename_match(
        lines, stats, file, fields, *track,
        track_number_from_filename, strip_filename_track_prefix,
    )
    chk.check_title_number_prefix(
        lines, stats, file, fields, "tracknumber",
        track_number_from_filename,
    )
    chk.check_title_matches_field(lines, stats, file, fields, "artist")
    check_artist_matches_artists(lines, stats, file, fields)


def run_check_step(args):
    """Scan a queue file for likely mistakes, interactively asking
    what to do about each one. No API calls, no root needed."""
    chk.run_check(args.queue, check_album, check_track)


