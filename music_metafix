ROOT_HEADER_RE = re.compile(r"^#\s*root:\s*(.+?)\s*$")


def read_root_header(queue_file):
    """The root path `scan` stamped at the top of `queue_file`, or
    None if it's missing (e.g. a hand-written queue file)."""
    with open(queue_file, encoding="utf-8") as f:
        first_line = f.readline()
    match = ROOT_HEADER_RE.match(first_line)
    return match.group(1) if match else None


def verify_queue_root(queue_file, root):
    """Abort if `queue_file` was scanned against a different root than
    the one `apply` is being run with."""
    stored_root = read_root_header(queue_file)
    if stored_root is None:
        warn(f"{queue_file} has no recorded root -- skipping root check.")
        return
    resolved_root = str(Path(root).resolve())
    if stored_root != resolved_root:
        print(
            f"Error: {queue_file} was scanned for root {stored_root!r}, "
            f"but apply was given root {resolved_root!r}.",
            file=sys.stderr,
        )
        sys.exit(1)


def queue_fields_to_tag_updates(fields):
    """Convert queue `fields` into the {key: value} shape set_tags
    expects, skipping null fields."""
    updates = {}
    for key in QUEUE_FIELDS:
        value = fields.get(key)
        if value is None:
            continue
        if key == "artists":
            updates[key] = [str(v) for v in value]
        elif key == "title":
            updates[key] = str(value).strip()
        else:
            updates[key] = str(value)
    return updates


def apply_one_file(root, spec, file, fields):
    """Apply one queue entry to its on-disk tags. Returns "applied",
    "ignored", or "error" (already warned about)."""
    path = root / file
    if is_ignored(spec, root, path):
        warn(f"Ignored by .mmfignore, skipping: {path}")
        return "ignored"
    if not path.exists():
        warn_missing_file(path)
        return "error"

    try:
        updates = queue_fields_to_tag_updates(fields)
        if updates:
            handle = load_track(path)
            if handle is None:
                raise RuntimeError("could not read tags")
            set_tags(handle, updates)

        print(f"Applied: {path}")
        return "applied"
    except Exception as exc:
        warn(f"Failed to apply changes to {path}: {exc}")
        return "error"


def apply_queue(root, queue_file):
    root = Path(root)
    spec = load_mmfignore(root)
    with open(queue_file, encoding="utf-8") as f:
        entries = yaml.safe_load(f) or {}

    counts = Counter()
    for file, fields in entries.items():
        counts[apply_one_file(root, spec, file, fields)] += 1

    print(
        f"\nDone. {counts['applied']} applied, {counts['error']} errors, "
        f"{counts['ignored']} ignored."
    )


def apply_album_art(root, art_dir):
    """Copy every queued album art file from art_dir onto its matching
    album under root, overwriting any existing file. Returns the
    number of files applied."""
    root = Path(root)
    art_dir = Path(art_dir)
    if not art_dir.exists():
        return 0

    spec = load_mmfignore(root)
    applied = 0
    for artist_dir in iter_dirs(art_dir):
        for album_dir in iter_dirs(artist_dir):
            dest_album_dir = root / artist_dir.name / album_dir.name
            if not dest_album_dir.is_dir():
                warn(f"No matching album for queued art: {album_dir}")
                continue
            if is_ignored(spec, root, dest_album_dir):
                continue
            for art_file in iter_files(album_dir):
                dest = dest_album_dir / art_file.name
                shutil.copyfile(art_file, dest)
                print(f"Album art applied: {dest}")
                applied += 1
    return applied


def run_apply(args):
    root = Path(args.root)
    verify_queue_root(args.queue, root)
    maybe_backup(args, root)

    apply_queue(root, args.queue)
    art_applied = apply_album_art(root, args.art_dir)
    if art_applied:
        print(f"{art_applied} album art file(s) applied.")


