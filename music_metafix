# check
# ---------------------------------------------------------------------------

FUZZY_SAME_ENOUGH = 0.92       # strings this similar count as "already correct"
FUZZY_MATCH_THRESHOLD = 0.6    # min similarity to accept a text-search match
TITLE_CHAR_DIFF_THRESHOLD = 3   # max chars for a filename/title to match

QUEUE_FIELDS = ("album", "artist", "artists", "title", "tracknumber")

QUEUE_HEADER = """\
# Music metadata changes queue.
#
# Review and edit the fields below as needed, then apply with:
#   {script} apply {root} {queue}
#
# Delete a field to skip just that change, or remove a whole file's entry
# to skip that file entirely. File paths (relative to root) are the keys.
# A "# was: ..." comment shows the field's previous value, where it had one.

"""

# (key, label, normalizer) for check_duplicate_fields's per-field checks.
DUPLICATE_FIELD_CHECKS = (
    ("title", "title", lambda v: str(v).strip().casefold()),
    ("tracknumber", "track number", normalize_track),
)


class RestartCheck(Exception):
    """Raised to resolve a warning by hand: pending changes are
    flushed, an editor opens on the queue file at `line`, and the
    whole check restarts from a fresh read."""

    def __init__(self, line=None):
        super().__init__()
        self.line = line


class CheckStats:
    """Mutable counters threaded through run_check's check_* helpers."""

    def __init__(self):
        self.warnings = 0
        self.resolved = 0
        self.changed = False


def find_entry_line(lines, file):
    """Return the raw-line index of `file`'s top-level key line, or None."""
    for i, line in enumerate(lines):
        if not line or line[0] in " #":
            continue
        try:
            parsed = yaml.safe_load(line)
        except yaml.YAMLError:
            continue
        if isinstance(parsed, dict) and file in parsed:
            return i
    return None


def entry_line_range(lines, start):
    """Return the exclusive end index of the entry starting at `start`."""
    end = start + 1
    while end < len(lines) and lines[end].startswith("  "):
        end += 1
    return end


def find_field_line(lines, file, key):
    """Return the raw-line index of `key` within `file`'s entry, or
    None if not found."""
    start = find_entry_line(lines, file)
    if start is None:
        return None
    end = entry_line_range(lines, start)
    for i in range(start + 1, end):
        if re.match(rf"^  {re.escape(key)}:", lines[i]):
            return i
    return None


def line_has_ok_comment(lines, index):
    """True if `lines[index]` carries a trailing '# OK' comment."""
    if index is None or index >= len(lines):
        return False
    return bool(re.search(r"# OK\b", lines[index], re.IGNORECASE))


def add_ok_comment(lines, index):
    """Append a trailing '# OK' comment to lines[index], in place."""
    if not line_has_ok_comment(lines, index):
        lines[index] += "  # OK"


def resolve_warning(lines, stats, message, ok_lines, restart_line):
    """Print `message` as a check warning and increment stats.warnings.
    If any `ok_lines` entry already carries "# OK", treat it as
    reviewed and return None. Otherwise prompt with CHECK_OPTIONS and
    return the chosen action -- "manual" raises RestartCheck at
    `restart_line`; "always_skip" marks every `ok_lines` entry "# OK"."""
    stats.warnings += 1
    if any(line_has_ok_comment(lines, i) for i in ok_lines):
        print(f"  ! {message}")
        return None
    action = prompt_action(message)
    if action == "manual":
        raise RestartCheck(restart_line)
    if action == "always_skip":
        for i in ok_lines:
            if i is not None:
                add_ok_comment(lines, i)
        stats.changed = True
        stats.resolved += 1
    return action


def group_field_values(group, key, normalize):
    """Group an album's [(file, fields), ...] by the normalized value
    of `key`, skipping entries missing it or normalizing to None.
    Returns {normalized_value: [(file, raw_value), ...]}."""
    seen = {}
    for file, fields in group:
        value = fields.get(key)
        if value is None:
            continue
        norm = normalize(value)
        if norm is not None:
            seen.setdefault(norm, []).append((file, value))
    return seen


def find_duplicate_fields(group, key, normalize):
    """Groups from `group_field_values` with 2+ occurrences, as a list
    of [(file, raw_value), ...] lists."""
    groups = group_field_values(group, key, normalize)
    return [dupes for dupes in groups.values() if len(dupes) > 1]


def find_inconsistent_field(group, key):
    """None if `group` agrees on `key` (or fewer than 2 have a value),
    else the full {value: [(file, raw_value), ...]} grouping."""
    groups = group_field_values(group, key, lambda v: str(v).strip())
    return groups if len(groups) > 1 else None


def parse_track_total(raw):
    """The "/N" total from a tracknumber field like "3/12", or None."""
    if not isinstance(raw, str) or "/" not in raw:
        return None
    total_part = raw.split("/", 1)[1].strip()
    return int(total_part) if total_part.isdigit() else None


def find_inconsistent_totals(group):
    """None if fewer than 2 distinct track-totals appear in `group`,
    else the full {total: [(file, raw_value), ...]} grouping."""
    groups = group_field_values(group, "tracknumber", parse_track_total)
    return groups if len(groups) > 1 else None


def check_partial_track_numbers(lines, stats, album_dir, group):
    """Warn if only some tracks in an album got a new track number."""
    has_update = ["tracknumber" in fields for _file, fields in group]
    if not any(has_update) or all(has_update):
        return

    message = (
        f"{album_dir}: only {sum(has_update)} tracks in this album "
        f"were given a new track number."
    )
    entry_line = find_entry_line(lines, group[0][0])
    resolve_warning(lines, stats, message, [entry_line], entry_line)


def check_track_number_gaps(lines, stats, album_dir, group):
    """Warn if the queued track numbers for an album skip one."""
    track_nums = sorted(
        {normalize_track(fields.get("tracknumber"))
         for _file, fields in group} - {None}
    )
    if len(track_nums) < 2:
        return
    missing = sorted(
        set(range(track_nums[0], track_nums[-1] + 1)) - set(track_nums)
    )
    if not missing:
        return

    message = (
        f"{album_dir}: track number(s) "
        f"{', '.join(str(n) for n in missing)} missing between "
        f"{track_nums[0]} and {track_nums[-1]} in the queue."
    )
    entry_line = find_entry_line(lines, group[0][0])
    resolve_warning(lines, stats, message, [entry_line], entry_line)


def check_duplicate_fields(lines, stats, album_dir, group):
    """Warn about tracks in an album sharing a title or track number."""
    for key, label, normalize in DUPLICATE_FIELD_CHECKS:
        for dupes in find_duplicate_fields(group, key, normalize):
            dupe_files = [file for file, _value in dupes]
            message = (
                f"{album_dir}: {len(dupes)} tracks were given the "
                f"same {label} {dupes[0][1]!r}: {', '.join(dupe_files)}."
            )
            dupe_lines = [
                find_field_line(lines, file, key) for file in dupe_files
            ]
            resolve_warning(lines, stats, message, dupe_lines, dupe_lines[0])


def check_inconsistent_totals(lines, stats, album_dir, group):
    """Warn if tracks in an album disagree on the "/N" track total."""
    totals = find_inconsistent_totals(group)
    if not totals:
        return

    parts = [
        f"{total} ({', '.join(f for f, _v in files)})"
        for total, files in totals.items()
    ]
    message = (
        f"{album_dir}: tracks disagree on the total track count: "
        f"{', '.join(parts)}."
    )
    total_lines = [
        find_field_line(lines, f, "tracknumber")
        for files in totals.values() for f, _v in files
    ]
    resolve_warning(lines, stats, message, total_lines, total_lines[0])


def check_inconsistent_fields(lines, stats, album_dir, group):
    """Warn if tracks in an album disagree on the folder-trusted
    artist or album -- likely a hand-edit typo in the queue."""
    for key in ("artist", "album"):
        variants = find_inconsistent_field(group, key)
        if not variants:
            continue

        parts = [
            f"{value!r} ({', '.join(f for f, _v in files)})"
            for value, files in variants.items()
        ]
        message = (
            f"{album_dir}: entries disagree on {key}: {', '.join(parts)}."
        )
        variant_lines = [
            find_field_line(lines, f, key)
            for files in variants.values() for f, _v in files
        ]
        resolve_warning(lines, stats, message, variant_lines, variant_lines[0])


ALBUM_CHECKS = (
    check_partial_track_numbers,
    check_track_number_gaps,
    check_duplicate_fields,
    check_inconsistent_totals,
    check_inconsistent_fields,
)


def check_null_and_blank_fields(lines, stats, file, fields):
    """Warn about any field that's null or blank/whitespace-only."""
    for key, value in list(fields.items()):
        if value is None:
            message = (
                f"{file}: {key} couldn't be determined, and is set "
                f"to null."
            )
        elif isinstance(value, str) and not value.strip():
            message = (
                f"{file}: {key} is set to a blank/whitespace-only "
                f"value."
            )
        else:
            continue

        field_line = find_field_line(lines, file, key)
        resolve_warning(lines, stats, message, [field_line], field_line)


def check_track_number_is_int(lines, stats, file, fields):
    """Warn if tracknumber isn't an integer."""
    raw_track = fields.get("tracknumber")
    if raw_track is None or isinstance(raw_track, int):
        return
    message = f"{file}: track number is not an integer: {raw_track!r}."
    tnum_line = find_field_line(lines, file, "tracknumber")
    resolve_warning(lines, stats, message, [tnum_line], tnum_line)


def check_track_number_in_range(lines, stats, file, fields, group):
    """Warn if tracknumber exceeds the album's track count."""
    raw_track = fields.get("tracknumber")
    if not isinstance(raw_track, int) or raw_track <= len(group):
        return
    message = (
        f"{file}: track number {raw_track} is greater than the "
        f"{len(group)} occurrence(s) of this album in the queue."
    )
    tnum_line = find_field_line(lines, file, "tracknumber")
    resolve_warning(lines, stats, message, [tnum_line], tnum_line)


def check_track_number_nonzero(lines, stats, file, fields):
    """Warn if tracknumber is 0, which usually means it's unset."""
    if fields.get("tracknumber") != 0:
        return
    message = f"{file}: track number is 0, which usually means it's unset."
    tnum_line = find_field_line(lines, file, "tracknumber")
    resolve_warning(lines, stats, message, [tnum_line], tnum_line)


def check_filename_match(lines, stats, file, fields):
    """Warn if the filename matches neither the queued title nor
    track number."""
    title = fields.get("title")
    track_no = normalize_track(fields.get("tracknumber"))
    if track_no is None and title is None:
        return

    stem = Path(file).stem
    filename_track = track_number_from_filename(stem)
    track_matches = (
        filename_track is not None and track_no is not None
        and filename_track == track_no
    )

    title_matches = False
    if title:
        title_guess = strip_filename_track_prefix(stem).lower().strip()
        diff = char_diff_count(title_guess, title.lower().strip())
        title_matches = diff <= TITLE_CHAR_DIFF_THRESHOLD

    if track_matches or title_matches:
        return

    mismatches = []
    if track_no is not None:
        mismatches.append(f"track number {track_no}")
    if title is not None:
        mismatches.append(f"title {title!r}")
    message = (
        f"{file}: filename doesn't match its new "
        f"{' or '.join(mismatches)}."
    )
    ok_lines = [
        find_field_line(lines, file, "tracknumber")
        if track_no is not None else None,
        find_field_line(lines, file, "title") if title is not None else None,
    ]
    restart_line = find_entry_line(lines, file)
    resolve_warning(lines, stats, message, ok_lines, restart_line)


def check_title_track_prefix(lines, stats, file, fields):
    """Warn if the title still starts with its own track number, e.g.
    "19-2000" at track 19 -- a leftover from recognition."""
    title = fields.get("title")
    track_no = normalize_track(fields.get("tracknumber"))
    if not title or track_no is None:
        return
    if track_number_from_filename(title) != track_no:
        return

    message = (
        f"{file}: title still starts with its own track number: "
        f"{title!r}."
    )
    title_line = find_field_line(lines, file, "title")
    resolve_warning(lines, stats, message, [title_line], title_line)


def check_title_matches_other_field(lines, stats, file, fields):
    """Warn if the queued title nearly matches the artist name --
    likely a wrong MusicBrainz match. (Not checked against album --
    eponymous tracks are common.)"""
    title = fields.get("title")
    if not title:
        return

    other_key = "artist"
    other_value = fields.get(other_key)
    if not other_value:
        return
    if fuzzy_ratio(title, str(other_value)) < FUZZY_SAME_ENOUGH:
        return

    message = (
        f"{file}: new title matches the {other_key} "
        f"({other_value!r}) almost exactly -- possible wrong match."
    )
    title_line = find_field_line(lines, file, "title")
    resolve_warning(lines, stats, message, [title_line], title_line)


def check_artist_matches_artists(lines, stats, file, fields):
    """Warn if the queued artist doesn't match artists[0] -- they
    should normally agree."""
    artist = fields.get("artist")
    artists = fields.get("artists")
    if not artist or not artists:
        return
    if str(artists[0]).strip() == str(artist).strip():
        return

    message = (
        f"{file}: artist {artist!r} doesn't match the first entry in "
        f"artists {artists!r}."
    )
    ok_lines = [
        find_field_line(lines, file, "artist"),
        find_field_line(lines, file, "artists"),
    ]
    restart_line = find_entry_line(lines, file)
    resolve_warning(lines, stats, message, ok_lines, restart_line)


def write_queue_lines(queue_file, lines):
    with open(queue_file, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def run_check(queue_file):
    """Scan a queue file for likely mistakes, interactively asking
    what to do about each one. No API calls, no root needed."""
    with open(queue_file, encoding="utf-8") as f:
        raw_text = f.read()
    lines = raw_text.splitlines()
    entries = yaml.safe_load(raw_text) or {}

    album_entries = {}  # album dir -> [(file, fields), ...] for that album
    for file, fields in entries.items():
        album_entries.setdefault(Path(file).parent, []).append((file, fields))

    stats = CheckStats()

    try:
        for album_dir, group in album_entries.items():
            for check in ALBUM_CHECKS:
                check(lines, stats, album_dir, group)

            for file, fields in list(group):
                check_null_and_blank_fields(lines, stats, file, fields)
                check_track_number_is_int(lines, stats, file, fields)
                check_track_number_in_range(lines, stats, file, fields, group)
                check_track_number_nonzero(lines, stats, file, fields)
                check_filename_match(lines, stats, file, fields)
                check_title_track_prefix(lines, stats, file, fields)
                check_title_matches_other_field(lines, stats, file, fields)
                check_artist_matches_artists(lines, stats, file, fields)
    except RestartCheck as restart:
        if stats.changed:
            write_queue_lines(queue_file, lines)
        editor = os.environ.get("EDITOR", "vi")
        line = restart.line + 1 if restart.line is not None else None
        subprocess.call(build_editor_command(editor, queue_file, line))
        print(f"\nRe-checking {queue_file} after manual edits...\n")
        run_check(queue_file)
        return

    if stats.changed:
        write_queue_lines(queue_file, lines)

    if stats.warnings:
        print(
            f"\n{stats.warnings} warning(s) found in {queue_file}, "
            f"{stats.resolved} resolved"
        )
    else:
        print(f"\nNo inconsistencies found in {queue_file}")


